+            } else {
+                const raw = if (self.pool) |pool| try pool.take(t.bytes) else try std.heap.page_allocator.alloc(u8, t.bytes);
+                errdefer if (self.pool) |pool| pool.put(raw) else std.heap.page_allocator.free(raw);
+                try out.items.append(a, .{ .tensor = t, .raw = raw });
+            }
+        }
+        if (async_read) out.thread = try std.Thread.spawn(.{}, Batch.run, .{out}) else out.run();
+        return out;
+    }
+};
+pub const Batch = struct {
+    const Item = struct { tensor: Tensor, raw: []u8, mapped: bool = false, skip: usize = 0 };
+    pool: ?*RawPool = null,
+    mapped_copy: bool = false,
+    items: std.ArrayList(Item) = .empty,
+    thread: ?std.Thread = null,
+    failure: ?anyerror = null,
+    consumed: bool = false,
+    read_ms: i64 = 0,
+    const Buffer = struct { bytes: []u8, mapped: bool, pool: ?*RawPool };
+    fn releaseBuffer(payload: ?*anyopaque) callconv(.c) void {
+        const buffer: *Buffer = @ptrCast(@alignCast(payload.?));
+        if (buffer.mapped) std.posix.munmap(@alignCast(buffer.bytes)) else if (buffer.pool) |pool| pool.put(buffer.bytes) else std.heap.page_allocator.free(buffer.bytes);
+        a.destroy(buffer);
+    }
+    fn run(self: *Batch) void {
+        const start = clock();
+        defer self.read_ms = clock() - start;
+        for (self.items.items) |v| if (!v.mapped) readAt(v.tensor.fd, v.raw, v.tensor.offset) catch |err| {
+            self.failure = err;
+            return;
+        };
+    }
+    fn join(self: *Batch) void {
+        if (self.thread) |t| {
+            t.join();
+            self.thread = null;
+        }
+    }
+    pub fn weights(self: *Batch) !Weights {
+        const start = clock();
+        self.join();
+        stats.wait_ms += clock() - start;
+        stats.read_ms += self.read_ms;
+        for (self.items.items) |v| stats.bytes += v.tensor.bytes;
+        if (self.consumed) return error.BatchAlreadyConsumed;
+        self.consumed = true;
+        if (self.failure) |err| return err;
+        var w = Weights.init(a);
+        errdefer w.deinit();
+        for (self.items.items) |*item| {
+            const t = item.tensor;
+            const buffer = try a.create(Buffer);
+            buffer.* = .{ .bytes = item.raw, .mapped = item.mapped, .pool = self.pool };
+            const ptr = item.raw.ptr;
+            item.raw = &.{};
+            const arr = if (item.mapped) blk: {
+                const length = [_]c_int{@intCast(buffer.bytes.len)};
+                const raw = mlx.mlx_array_new_data_managed_payload(ptr, &length, 1, .uint8, buffer, releaseBuffer);
+                defer _ = mlx.mlx_array_free(raw);
+                const stream = mlx.mlx_default_gpu_stream_new();
+                defer _ = mlx.mlx_stream_free(stream);
+                var bytes = mlx.mlx_array_new();
+                defer _ = mlx.mlx_array_free(bytes);
+                const slice_start = [_]c_int{@intCast(item.skip)};
+                const stop = [_]c_int{@intCast(item.skip + t.bytes)};
+                const stride = [_]c_int{1};
+                try mlx.check(mlx.mlx_slice(&bytes, raw, &slice_start, 1, &stop, 1, &stride, 1, stream));
+                var typed = mlx.mlx_array_new();
+                defer _ = mlx.mlx_array_free(typed);
+                try mlx.check(mlx.mlx_view(&typed, bytes, t.dtype, stream));
+                var shaped = mlx.mlx_array_new();
+                errdefer _ = mlx.mlx_array_free(shaped);
+                try mlx.check(mlx.mlx_reshape(&shaped, typed, t.shape.ptr, t.shape.len, stream));
+                if (self.mapped_copy) {
+                    var aligned = mlx.mlx_array_new();
+                    errdefer _ = mlx.mlx_array_free(aligned);
+                    try mlx.check(mlx.mlx_copy(&aligned, shaped, stream));
+                    try mlx.check(mlx.mlx_array_eval(aligned));
+                    _ = mlx.mlx_array_free(shaped);
+                    break :blk aligned;
+                }
+                break :blk shaped;
+            } else mlx.mlx_array_new_data_managed_payload(ptr, t.shape.ptr, @intCast(t.shape.len), t.dtype, buffer, releaseBuffer);
+            try w.put(t.name, arr);
+        }
+        return w;
+    }
+    pub fn deinit(self: *Batch) void {
+        self.join();
+        for (self.items.items) |v| if (v.raw.len > 0) {
+            if (v.mapped) std.posix.munmap(@alignCast(v.raw)) else if (self.pool) |pool| pool.put(v.raw) else std.heap.page_allocator.free(v.raw);
+        };
+        self.items.deinit(a);
+        a.destroy(self);
+    }
+};
