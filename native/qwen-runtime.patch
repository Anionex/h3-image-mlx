+        refs.deinit(a);
+    }
+    if (fields.get("image")) |v| try refs.append(a, try decoded(v));
+    if (fields.get("ref_images")) |v| {
+        if (v != .array) return error.InvalidReferences;
+        for (v.array.items) |ref| try refs.append(a, try decoded(ref));
+    }
+    const j = switch (request.parse(fields, refs.items, .{ .img2img = true, .edit = true, .guidance = true, .edit_ref_cap = 10, .transparent = true, .ref_resolution = true })) {
+        .ok => |v| v,
+        .bad => |v| {
+            std.debug.print("request: {s}\n", .{v.why.slice()});
+            return error.InvalidRequest;
+        },
+    };
+    q.request_streaming = streaming or cache != null;
+    q.request_prefetch = prefetch;
+    var engine = try q.Engine.loadOn(io, a, model, true, s);
+    defer engine.deinit();
+    if (cache) |dir| try engine.dit.useCache(io, dir);
+    if (!streaming and cache != null) try engine.dit.makeResident();
+    var loras: LoraSet = .{};
+    defer loras.clear(&engine.dit);
+    var adapters: [8]abi.Lora = undefined;
+    var count: usize = 0;
+    if (fields.get("lora_paths")) |paths| {
+        const scales = fields.get("lora_scales") orelse return error.MissingLoraScales;
+        if (paths != .array or scales != .array or paths.array.items.len != scales.array.items.len or paths.array.items.len > adapters.len) return error.InvalidLoras;
+        for (paths.array.items, scales.array.items) |path, scale| {
+            if (path != .string) return error.InvalidLoraPath;
+            const gain: f32 = switch (scale) {
+                .float => |v| @floatCast(v),
+                .integer => |v| @floatFromInt(v),
+                else => return error.InvalidLoraScale,
+            };
+            adapters[count] = .{ .path = .of(path.string), .scale = gain };
+            count += 1;
+        }
+    }
+    const verdict = loras.set(a, adapters[0..count], .qwen_image21, &engine.dit);
+    if (!verdict.isOk()) {
+        std.debug.print("lora: {s}\n", .{verdict.why.slice()});
+        return error.LoraAttachFailed;
+    }
+    var sigma_buf: [100]f32 = undefined;
+    const sigmas = try q.requestSigmas(fields.get("sample_sigmas"), j.steps, &sigma_buf);
+    const steps: u32 = if (sigmas) |v| @intCast(v.len) else engine.stepsFor(j.steps);
+    var context: u8 = 0;
+    const progress: Progress = .{ .ctx = &context, .cb = emit, .yields = false };
+    const cfg = @import("plugins/qwen_image/config.zig");
+    const prefix_cache = if (j.mode == .edit) cfg.editPlan(steps, cfg.editTransientBytes(@intCast(refs.items.len), j.ref_resolution, j.req_w, j.req_h), cfg.editPrefixBytes(@intCast(refs.items.len), j.ref_resolution, engine.dit_cfg.layers, engine.dit_cfg.hidden(), if (j.guidance_scale != 1) 2 else 1), @import("sdk/media/job.zig").gpuHeadroom()) orelse return error.EditWorkingSetTooLarge else false;
+    const img = if (j.mode == .edit)
+        try engine.editImage(a, j.prompt, refs.items, j.req_w, j.req_h, j.seed, steps, .{
+            .guidance_scale = j.guidance_scale,
+            .negative_prompt = j.negative_prompt,
+            .ref_resolution = j.ref_resolution,
+            .transparent = j.transparent,
+            .prefix_cache = prefix_cache,
+            .sample_sigmas = sigmas,
+        }, progress)
+    else blk: {
+        var opts: q.GenOpts = .{ .guidance_scale = j.guidance_scale, .negative_prompt = j.negative_prompt, .transparent = j.transparent, .sample_sigmas = sigmas };
+        const source = if (j.mode == .variation) pixels.decodeVariation(a, j.image.?, j.req_h, j.req_w, j.strength) orelse return error.InvalidImage else null;
+        defer if (source) |v| {
+            _ = mlx.mlx_array_free(v);
+        };
+        if (source) |v| {
+            opts.init_image = v;
+            opts.start_step = request.img2imgStartStep(steps, j.strength);
+        }
+        break :blk try engine.generateImage(a, j.prompt, j.req_w, j.req_h, j.seed, steps, opts, progress);
+    };
+    defer _ = mlx.mlx_array_free(img);
+    const png = try pixels.toPng(a, img, s);
+    defer a.free(png);
+    var offset: usize = 0;
+    while (offset < png.len) {
+        const n = write(1, png[offset..].ptr, png.len - offset);
+        if (n <= 0) return error.WriteImage;
+        offset += @intCast(n);
+    }
+}
