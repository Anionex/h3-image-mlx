+//! Full-feature single-request pipe entry point for the desktop streaming runner.
+const std = @import("std");
+const mlx = @import("mlx/ffi.zig");
+const q = @import("plugins/qwen_image/qwen_image.zig");
+const abi = @import("abi/media.zig");
+const request = @import("sdk/media/image_request.zig");
+const pixels = @import("sdk/media/image_pixels.zig");
+const LoraSet = @import("sdk/media/lora_set.zig").LoraSet;
+const Progress = @import("sdk/media/progress.zig").Progress;
