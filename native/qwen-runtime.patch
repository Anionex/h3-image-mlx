+                const value = try wide.decodeRgba(in.get("value").?);
+                try mlx.check(mlx.mlx_array_eval(value));
+                break :blk value;
+            };
+            if (!try q.allPixelsFinite(decoded, s)) return error.NonFiniteVae;
+        }
+        defer free(decoded);
+        try mlx.check(mlx.mlx_array_eval(decoded));
+        // Save raw pixels as the numerical oracle; PNG conversion is outside inference.
+        try save(output, decoded);
+    } else if (std.mem.eql(u8, stage, "copy")) {
+        const reader = @import("sdk/weights/block_reader.zig");
+        var src = try reader.Source.open(init.io, model);
+        src.mapped = q.micro_mmap;
+        src.mapped_copy = q.micro_mapped_copy;
+        defer src.deinit();
+        const batch = try src.batch(input, false, prefetch);
+        defer batch.deinit();
+        var w = try batch.weights();
+        defer w.deinit();
+        if (w.count() == 0) return error.MissingStreamGroup;
+        const map = mlx.mlx_map_string_to_array_new();
+        defer _ = mlx.mlx_map_string_to_array_free(map);
+        const meta = mlx.mlx_map_string_to_string_new();
+        defer _ = mlx.mlx_map_string_to_string_free(meta);
+        var wi = w.map.iterator();
+        while (wi.next()) |e| {
+            const key = try a.dupeSentinel(u8, e.key_ptr.*, 0);
+            defer a.free(key);
+            try mlx.check(mlx.mlx_map_string_to_array_insert(map, key, e.value_ptr.*));
+        }
+        try mlx.check(mlx.mlx_save_safetensors(output, map, meta));
+    } else return error.UnknownStage;
+    var peak: usize = 0;
+    try mlx.check(mlx.mlx_get_peak_memory(&peak));
+    var usage: [16 + 35 * 8]u8 align(8) = @splat(0);
+    const sampled = proc_pid_rusage(getpid(), 4, &usage) == 0;
+    const physical_peak = if (sampled) std.mem.readInt(u64, usage[16 + 28 * 8 ..][0..8], .little) else 0;
+    const disk_read = if (sampled) std.mem.readInt(u64, usage[16 + 16 * 8 ..][0..8], .little) else 0;
+    const rs = @import("sdk/weights/block_reader.zig").stats;
+    std.debug.print("STREAM {{\"read_ms\":{d},\"wait_ms\":{d},\"bytes\":{d}}}\n", .{ rs.read_ms, rs.wait_ms, rs.bytes });
+    std.debug.print("FOOTPRINT {d} DISK_READ {d}\n", .{ physical_peak, disk_read });
+    std.debug.print("METRICS {{\"stage\":\"{s}\",\"elapsed_ms\":{d},\"mlx_peak_bytes\":{d}}}\n", .{ stage, started.durationTo(std.Io.Timestamp.now(init.io, .awake)).toMilliseconds(), peak });
+}
