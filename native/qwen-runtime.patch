diff --git a/src/sdk/weights/block_reader.zig b/src/sdk/weights/block_reader.zig
new file mode 100644
index 0000000..02df9f1
--- /dev/null
+++ b/src/sdk/weights/block_reader.zig
@@ -0,0 +1,250 @@
+//! Bounded raw-byte prefetch. Only the inference thread creates MLX arrays.
+const std = @import("std");
+const mlx = @import("../../mlx/ffi.zig");
+const Weights = @import("resident.zig").Weights;
+const a = std.heap.c_allocator;
+const clock = @import("../util/crt.zig").monotonicMs;
+const RawPool = struct {
+    mutex: @import("../util/os_mutex.zig").Mutex = .{},
+    refs: std.atomic.Value(usize) = .init(1),
+    free: std.ArrayList([]u8) = .empty,
+    bytes: usize = 0,
+    fn release(self: *RawPool) void {
+        if (self.refs.fetchSub(1, .acq_rel) != 1) return;
+        for (self.free.items) |v| std.heap.page_allocator.free(v);
+        self.free.deinit(a);
+        a.destroy(self);
+    }
+    fn take(self: *RawPool, length: usize) ![]u8 {
+        self.mutex.lock();
+        for (self.free.items, 0..) |v, i| if (v.len == length) {
+            _ = self.free.swapRemove(i);
+            self.bytes -= length;
+            _ = self.refs.fetchAdd(1, .monotonic);
+            self.mutex.unlock();
+            return v;
+        };
+        self.mutex.unlock();
+        const v = try std.heap.page_allocator.alloc(u8, length);
+        _ = self.refs.fetchAdd(1, .monotonic);
+        return v;
+    }
+    fn put(self: *RawPool, v: []u8) void {
+        self.mutex.lock();
+        const keep = self.bytes + v.len <= 224 << 20;
+        if (keep) {
+            self.free.append(a, v) catch {
+                self.mutex.unlock();
+                std.heap.page_allocator.free(v);
+                self.release();
+                return;
+            };
+            self.bytes += v.len;
+        }
+        self.mutex.unlock();
+        if (!keep) std.heap.page_allocator.free(v);
+        self.release();
+    }
+};
+pub var stats: struct { read_ms: i64 = 0, wait_ms: i64 = 0, bytes: u64 = 0 } = .{};
+
+const Tensor = struct { name: []const u8, fd: c_int, offset: u64, bytes: usize, shape: []c_int, dtype: mlx.mlx_dtype };
+fn readAt(fd: c_int, bytes: []u8, offset: u64) !void {
+    var done: usize = 0;
+    while (done < bytes.len) {
+        const n = std.c.pread(fd, bytes[done..].ptr, bytes.len - done, @intCast(offset + done));
+        if (n < 0) {
+            if (std.c._errno().* == @backingInt(std.posix.E.INTR)) continue;
+            return error.WeightReadFailed;
+        }
+        if (n == 0) return error.TruncatedWeight;
+        done += @intCast(n);
+    }
+}
+fn dtypeOf(name: []const u8) !mlx.mlx_dtype {
+    const names = .{ "BF16", "F16", "F32", "U32", "I8", "U8", "I32" };
+    const types = .{ mlx.mlx_dtype.bfloat16, mlx.mlx_dtype.float16, mlx.mlx_dtype.float32, mlx.mlx_dtype.uint32, mlx.mlx_dtype.int8, mlx.mlx_dtype.uint8, mlx.mlx_dtype.int32 };
+    inline for (names, types) |n, t| if (std.mem.eql(u8, name, n)) return t;
+    return error.UnsupportedStreamDtype;
+}
+pub const Source = struct {
+    pool: ?*RawPool = null,
+    mapped: bool = false,
+    mapped_copy: bool = false,
+    arena: std.heap.ArenaAllocator,
+    tensors: std.ArrayList(Tensor) = .empty,
+    fds: std.ArrayList(c_int) = .empty,
+    pub fn enableReuse(self: *Source) !void {
+        if (self.pool != null) return;
+        const pool = try a.create(RawPool);
+        pool.* = .{};
+        self.pool = pool;
+    }
+    pub fn open(io: std.Io, dirpath: []const u8) !Source {
+        var self: Source = .{ .arena = .init(a) };
+        errdefer self.deinit();
+        const alloc = self.arena.allocator();
+        var dir = try std.Io.Dir.openDirAbsolute(io, dirpath, .{ .iterate = true });
+        defer dir.close(io);
+        var it = dir.iterate();
+        while (try it.next(io)) |entry| {
+            if (!std.mem.endsWith(u8, entry.name, ".safetensors")) continue;
+            const path = try std.fmt.allocPrintSentinel(alloc, "{s}/{s}", .{ dirpath, entry.name }, 0);
+            const fd = std.c.open(path, .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, @as(std.c.mode_t, 0));
+            if (fd < 0) return error.WeightOpenFailed;
+            try self.fds.append(alloc, fd);
+            var lenbuf: [8]u8 = undefined;
+            try readAt(fd, &lenbuf, 0);
+            const len = std.mem.readInt(u64, &lenbuf, .little);
+            if (len > 64 << 20) return error.InvalidWeightHeader;
+            const raw = try alloc.alloc(u8, @intCast(len));
+            try readAt(fd, raw, 8);
+            const header = try std.json.parseFromSliceLeaky(std.json.Value, alloc, raw, .{ .allocate = .alloc_always });
+            var h = header.object.iterator();
+            while (h.next()) |e| {
+                if (std.mem.eql(u8, e.key_ptr.*, "__metadata__")) continue;
+                const v = e.value_ptr.object;
+                const sh = v.get("shape").?.array.items;
+                const shape = try alloc.alloc(c_int, sh.len);
+                for (sh, shape) |x, *d| d.* = @intCast(x.integer);
+                const off = v.get("data_offsets").?.array.items;
+                try self.tensors.append(alloc, .{ .name = e.key_ptr.*, .fd = fd, .offset = 8 + len + @as(u64, @intCast(off[0].integer)), .bytes = @intCast(off[1].integer - off[0].integer), .shape = shape, .dtype = try dtypeOf(v.get("dtype").?.string) });
+            }
+        }
+        if (self.tensors.items.len == 0) return error.NoWeightFiles;
+        return self;
+    }
+    pub fn rows(self: *const Source, name: []const u8, ids: []const i32) !mlx.mlx_array {
+        for (self.tensors.items) |t| if (std.mem.eql(u8, t.name, name)) {
+            if (t.shape.len != 2 or (t.dtype != .bfloat16 and t.dtype != .float16 and t.dtype != .float32)) return error.StreamEmbeddingLayout;
+            const stride = t.bytes / @as(usize, @intCast(t.shape[0]));
+            const raw = try a.alloc(u8, ids.len * stride);
+            defer a.free(raw);
+            for (ids, 0..) |id, i| {
+                if (id < 0 or id >= t.shape[0]) return error.InvalidToken;
+                try readAt(t.fd, raw[i * stride ..][0..stride], t.offset + @as(u64, @intCast(id)) * stride);
+            }
+            const shape = [_]c_int{ 1, @intCast(ids.len), t.shape[1] };
+            return mlx.mlx_array_new_data(raw.ptr, &shape, 3, t.dtype);
+        };
+        return error.MissingEmbedding;
+    }
+    pub fn deinit(self: *Source) void {
+        if (self.pool) |pool| pool.release();
+        for (self.fds.items) |fd| _ = std.c.close(fd);
+        self.arena.deinit();
+    }
+    pub fn batch(self: *const Source, prefix: []const u8, exclude: bool, async_read: bool) !*Batch {
+        const out = try a.create(Batch);
+        out.* = .{ .mapped_copy = self.mapped_copy, .pool = self.pool };
+        errdefer out.deinit();
+        for (self.tensors.items) |t| {
+            if (std.mem.startsWith(u8, t.name, prefix) == exclude) continue;
+            if (self.mapped and t.bytes > 0) {
+                var st: std.c.Stat = undefined;
+                if (std.c.fstat(t.fd, &st) != 0) return error.StatFailed;
+                if (t.offset + t.bytes > @as(u64, @intCast(st.size))) return error.TruncatedWeight;
+                const page = std.heap.pageSize();
+                const offset = t.offset & ~@as(u64, page - 1);
+                const skip: usize = @intCast(t.offset - offset);
+                const length = std.mem.alignForward(usize, skip + t.bytes, page);
+                const raw = try std.posix.mmap(null, length, .{ .READ = true }, .{ .TYPE = .PRIVATE }, t.fd, offset);
+                errdefer std.posix.munmap(raw);
