+extern "c" fn read(fd: c_int, buf: [*]u8, size: usize) isize;
+extern "c" fn write(fd: c_int, buf: [*]const u8, size: usize) isize;
+fn emit(_: *anyopaque, stage: []const u8, step: u32, total: u32) void {
+    std.debug.print("PROGRESS {{\"stage\":\"{s}\",\"step\":{d},\"total\":{d}}}\n", .{ stage, step, total });
+}
+fn decoded(value: std.json.Value) ![]u8 {
+    if (value != .string) return error.InvalidReference;
+    const decoder = std.base64.standard.Decoder;
+    const buf = try a.alloc(u8, try decoder.calcSizeForSlice(value.string));
+    errdefer a.free(buf);
+    try decoder.decode(buf, value.string);
+    return buf;
+}
+pub fn run(io: std.Io, s: mlx.mlx_stream, model: []const u8, cache: ?[]const u8, streaming: bool, prefetch: bool) !void {
+    var bytes: std.ArrayList(u8) = .empty;
+    defer bytes.deinit(a);
+    var chunk: [65536]u8 = undefined;
+    while (true) {
+        const n = read(0, &chunk, chunk.len);
+        if (n < 0) return error.ReadInput;
+        if (n == 0) break;
+        if (bytes.items.len + @as(usize, @intCast(n)) > 160 * 1024 * 1024) return error.InputTooLarge;
+        try bytes.appendSlice(a, chunk[0..@intCast(n)]);
+    }
+    var body = try std.json.parseFromSlice(std.json.Value, a, bytes.items, .{});
+    defer body.deinit();
+    if (body.value != .object) return error.InvalidRequest;
+    const fields: request.Fields = .{ .obj = body.value.object };
+    var refs: std.ArrayList([]const u8) = .empty;
+    defer {
